class FormatValidator:
    def __init__(self, cfg: Dict[str, Any]):
        self.cfg = cfg

    def validate(self, text: str, mode: str) -> Tuple[bool, Dict[str, Any]]:
        req = self.cfg["required_sections"].get(mode, [])
        ok = True
        report = {}
        for section in req:
            present = (section in text)
            report[section] = present
            ok = ok and present
        if self.cfg.get("iso_dates_only", True):
            if re.search(r"\b\d{1,2}\.\d{1,2}\.\d{4}\b", text):
