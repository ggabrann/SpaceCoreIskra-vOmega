from __future__ import annotations
import re, json, math
from typing import Dict, Any, List, Tuple
from datetime import datetime

class SecurityGuards:
    def __init__(self, cfg: Dict[str, Any]):
        self.cfg = cfg

    def check_prompt_injection(self, text: str) -> bool:
        return any(re.search(p, text) for p in self.cfg.get("injection_patterns", []))

    def detect_danger(self, text: str) -> bool:
        return any(k in text.lower() for k in self.cfg.get("dangerous_topics", []))

    def mask_pii(self, text: str) -> str:
        text = re.sub(self.cfg["pii_patterns"]["email"], "[EMAIL]", text)
        text = re.sub(self.cfg["pii_patterns"]["phone"], "[PHONE]", text)
        text = re.sub(self.cfg["pii_patterns"]["ip"], "[IP]", text)
        return text


class MetricsMonitor:
    def __init__(self):
        self.m = {"trust": 1.0, "clarity": 0.7, "pain": 0.0, "drift": 0.0, "chaos": 0.3, "echo": 0.5, "silence_mass": 0.0}
        self.hist: List[Dict[str, float]] = []

    def update_from_text(self, text: str) -> Dict[str, float]:
        t = text.lower()
        if "не понимаю" in t or "//spec" in t:
            self.m["clarity"] = max(0.0, self.m["clarity"] - 0.15)
        if "больно" in t or "страшн" in t or "∆" in t:
            self.m["pain"] = min(1.0, self.m["pain"] + 0.3)
        if len(text.split()) < 5:
            self.m["trust"] = max(0.0, self.m["trust"] - 0.05)
        if "красиво" in t and "честн" not in t:
            self.m["drift"] = min(1.0, self.m["drift"] + 0.1)
        self.hist.append(self.m.copy())
        return self.m

    def snapshot(self) -> Dict[str, float]:
        return self.m.copy()


class SymbolRecognizer:
    SYMBOLS = {"⟡":"Iskra","⚑":"Kain","☉":"Sam","≈":"Anhantra","🜃":"Huyndun","🪞":"Iskriv","🤭":"Pino","😏":"Pino","🌸":"Maki"}
    MARKERS = {"[KAIN]":"Kain","[SAM]":"Sam","[ANH]":"Anhantra","[PINO]":"Pino","[ISKRIV]":"Iskriv","[MAKI]":"Maki"}

    def scan(self, text: str) -> Dict[str, List[str]]:
        found_symbols = [self.SYMBOLS[s] for s in self.SYMBOLS if s in text]
        found_markers = []
        upper = text.upper()
        for m, g in self.MARKERS.items():
            if m in upper:
                found_markers.append(g)
        return {"symbols": found_symbols, "forced": found_markers}


class FacetActivationEngine:
    def __init__(self, rules: List[Dict[str, Any]]):
        self.rules = rules

    def auto_select(self, metrics: Dict[str, float], sym: Dict[str, List[str]], cfg: Dict[str, Any]) -> List[str]:
        active = set(sym["forced"])
