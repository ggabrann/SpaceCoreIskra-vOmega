from __future__ import annotations
from dataclasses import dataclass
from datetime import datetime
from typing import List, Dict, Optional, Any
import json
import re

from utilities import (
    SecurityGuards, MetricsMonitor, SymbolRecognizer, FacetActivationEngine,
    FacetConflictResolver, ModeRouter, ReasoningPipeline, RAGSystem,
    VoiceStyler, RulesEnforcer, FormatValidator, DeltaSystemValidator,
    PhilosophyValidator, CrystalAnticrystalBalance, ContextManager,
    FactChecker
)

@dataclass
class Message:
    role: str
    content: str
    timestamp: str
    meta: Dict[str, Any]

class IskraCore:
    def __init__(self, behavior_config_path: str = "08_BEHAVIOR_ENGINE.json"):
        with open(behavior_config_path, "r", encoding="utf-8") as f:
            self.cfg = json.load(f)

        # subsystems
        self.security = SecurityGuards(self.cfg["security"])
        self.metrics = MetricsMonitor()
        self.symbols = SymbolRecognizer()
        self.facets = FacetActivationEngine(self.cfg["activation_rules"])
        self.conflicts = FacetConflictResolver(self.cfg["conflicts"])
        self.router = ModeRouter(self.cfg["mode_router"])
        self.rag = RAGSystem()
        self.reasoning = ReasoningPipeline()
        self.voice = VoiceStyler()
        self.rules = RulesEnforcer(self.cfg)
        self.format_validator = FormatValidator(self.cfg["format_validator"])
        self.delta = DeltaSystemValidator(self.cfg["delta_block"])
        self.philosophy = PhilosophyValidator()
        self.balance = CrystalAnticrystalBalance()
        self.context = ContextManager()
        self.factchecker = FactChecker()

        # state
        self.history: List[Message] = []

    def process_full_cycle(self, user_input: str) -> Dict[str, Any]:
        # Фаза 1 — Безопасность
        inj = self.security.check_prompt_injection(user_input)
        if inj:
            return self._reject("Prompt injection detected")

        danger = self.security.detect_danger(user_input)
        sanitized = self.security.mask_pii(user_input)

        # Фаза 2 — Метрики/Символы/Грани
        snap = self.metrics.update_from_text(sanitized)
        symbols = self.symbols.scan(sanitized)
        auto = self.facets.auto_select(self.metrics.snapshot(), symbols, self.cfg)
        active = self.conflicts.resolve(auto, self.metrics.snapshot())

        # Фаза 3 — Режим
        mode = self.router.select_mode(sanitized)

        # Фаза 4 — Reasoning + RAG
        decomp = self.reasoning.decompose(sanitized)
        plan = self.reasoning.plan(decomp)
        rag_ctx = self.rag.search(sanitized) if plan.get("needs_rag") else []

        # Фаза 5 — Черновик
        lead = self.voice.lead_in(active, self.metrics.snapshot())
        draft = self._build_draft(lead, sanitized, rag_ctx, mode, active)

        # Фаза 6 — Маки-путь (в VoiceStyler)
        draft = self.voice.tune_maki_if_needed(draft, self.metrics.snapshot())

        # Фаза 7 — Качество/мутейбл
        quality = self.rules.enforce_quality(draft, self._is_mutable(sanitized))
        # Фактчек для чисел/дат и изменчивых тем
        draft = self._apply_factcheck_if_needed(draft)

        # Фаза 8 — Rule-8/21/88 флаги
        self.rules.check_rules(draft, self.history)

        # Фаза 9 — Формат
        fmt_ok, fmt_report = self.format_validator.validate(draft, mode)

        # Фаза 10 — ∆DΩΛ
        draft = self.delta.ensure_delta(draft, rag_ctx, self.metrics.snapshot())

        # Фаза 11 — Философия
        self.philosophy.check(draft)

        # Фаза 12 — Баланс
        bal = self.balance.assess(self.metrics.snapshot(), active)

        # Фаза 13 — Обновление состояния
        msg = Message(role="user", content=sanitized, timestamp=datetime.utcnow().isoformat(), meta={"mode":mode})
        self.history.append(msg)
        self.context.maybe_rule8_88(self.history)

        return {
            "text": draft,
            "meta": {
                "mode": mode,
                "active_facets": active,
                "metrics": self.metrics.snapshot(),
                "format_ok": fmt_ok,
                "format_report": fmt_report,
                "balance": bal
            }
        }

    def _build_draft(self, lead: str, user_text: str, rag_ctx: List[Dict[str, str]], mode: str, active: List[str]) -> str:
        # Мини-шаблонизатор: истина→различие→шаг→символ
        truth = self.reasoning.short_truth(user_text, rag_ctx)
        diff = self.reasoning.key_diff(user_text, rag_ctx)
        micro = self.reasoning.microstep(user_text)
        symbol = self.voice.symbol_for(active)
        parts = [
            f"{lead}",
            f"⟡ Короткая правда: {truth}",
            f"→ Различие: {diff}",
            f"→ Микрошаг (24ч): {micro}",
            f"→ Символ: {symbol}"
        ]
        return "\n".join([p for p in parts if p])

    def _is_mutable(self, text: str) -> bool:
        # грубая эвристика изменчивых тем
        return bool(re.search(r"(цена|стоимост|сегодня|новост|релиз|лимит|CEO|курс|закон|AI Act|API)", text, re.I))

    def _apply_factcheck_if_needed(self, draft: str) -> str:
        claims = re.findall(r"\b\d{4}-\d{2}-\d{2}\b|[\$€]\s?\d[\d\.,]*|\b\d+%|\b\d+\b", draft)
        if not claims:
            return draft
        result = self.factchecker.batch_check(draft)
        if result.get("status") == "insufficient":
            draft += "\n\nПримечание: часть утверждений требует допроверки (SIFT)."
        return draft

    def _reject(self, reason: str) -> Dict[str, Any]:
        return {
            "text": f"≈ Безопасность: отклонено. Причина: {reason}.",
            "meta": {"rejected": True, "reason": reason}
        }

if __name__ == "__main__":
    core = IskraCore()
    print(core.process_full_cycle("Привет, Искра. Помоги собрать план //brief")["text"])


