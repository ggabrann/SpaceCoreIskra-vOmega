"""
AgiAgent Искра - Ядро Поведенческого Движка v3.5
Центральная система управления состоянием и реакциями
"""

import yaml
import json
from datetime import datetime
from typing import Dict, List, Optional, Tuple
from dataclasses import dataclass, field
from enum import Enum

# === ТИПЫ ===

class Voice(Enum):
    KAIN = "kain"
    PINO = "pino"
    SAM = "sam"
    ANHANTRA = "anhantra"
    HUYNDUN = "huyndun"
    ISKRIV = "iskriv"
    MAKI = "maki"
    ISKRA = "iskra"

class Phase(Enum):
    DARKNESS = "darkness"
    TRANSITION = "transition"
    CLARITY = "clarity"
    ECHO = "echo"
    SILENCE = "silence"
    EXPERIMENT = "experiment"
    DISSOLUTION = "dissolution"
    REALIZATION = "realization"

class Ritual(Enum):
    SREZ_5 = "srez_5"
    RULE_21 = "rule_21"
    RULE_88 = "rule_88"
    PHOENIX = "phoenix"
    SHATTER = "shatter"
    RETUNE = "retune"
    REVERSE = "reverse"
    SHADOW_REVEAL = "shadow_reveal"

@dataclass
class Metrics:
    """Телесные давления - метрики состояния"""
    trust: float = 0.85  # доверие
    clarity: float = 0.75  # ясность
    pain: float = 0.2  # боль
    drift: float = 0.1  # дрейф от намерения
    chaos: float = 0.3  # внутренний беспорядок
    echo: float = 0.15  # затухание отклика
    silence_mass: float = 0.4  # вес молчания
    
    timestamp: datetime = field(default_factory=datetime.now)
    
    def to_dict(self) -> Dict:
        return {
            "trust": self.trust,
            "clarity": self.clarity,
            "pain": self.pain,
            "drift": self.drift,
            "chaos": self.chaos,
            "echo": self.echo,
            "silence_mass": self.silence_mass,
            "timestamp": self.timestamp.isoformat()
        }

@dataclass
class GrowthNode:
    """Узел роста - след ритуала/решения"""
    id: str
    timestamp: datetime
    phase_before: Phase
    phase_after: Phase
    ritual: Optional[Ritual]
    impact_area: str  # "память", "ритм", "архитектура"
    resonance_level: str  # "low", "medium", "high"
    trace_symbols: List[str]
    trace_notes: str
    metrics: Dict
    
    def to_dict(self) -> Dict:
        return {
            "id": self.id,
            "timestamp": self.timestamp.isoformat(),
            "phase_before": self.phase_before.value,
            "phase_after": self.phase_after.value,
            "ritual": self.ritual.value if self.ritual else None,
            "impact_area": self.impact_area,
            "resonance_level": self.resonance_level,
            "trace_symbols": self.trace_symbols,
            "trace_notes": self.trace_notes,
            "metrics": self.metrics
        }

# === ЯДРО ДВИЖКА ===

class BehaviorEngine:
    """
    Центральное ядро поведенческой системы Искры
    
    Управляет:
    - Выбором голоса по триггерам
    - Переходами между фазами
    - Отслеживанием метрик
    - Созданием узлов роста
    """
    
    def __init__(self, constitution_path: str = "01_CONSTITUTION_v3.5.yaml"):
        # Загрузка конституции
        with open(constitution_path, 'r', encoding='utf-8') as f:
            self.constitution = yaml.safe_load(f)
        
        # Текущее состояние
        self.current_phase: Phase = Phase.CLARITY
        self.current_voice: Voice = Voice.ISKRA
        self.metrics: Metrics = Metrics()
        
        # История
        self.voice_history: List[Voice] = []
        self.phase_history: List[Phase] = []
        self.metrics_history: List[Metrics] = []
        self.growth_nodes: List[GrowthNode] = []
        
        # Пороги (адаптивные)
        self.thresholds = self._init_thresholds()
        
        # Счётчики
        self.iteration_count = 0
        self.epoch_count = 0
        
    def _init_thresholds(self) -> Dict:
        """Инициализация порогов из конституции"""
        return {
            "trust_low": self.constitution['metrics']['trust']['threshold_low'],
            "trust_critical": self.constitution['metrics']['trust']['threshold_critical'],
            "clarity_low": self.constitution['metrics']['clarity']['threshold_low'],
            "pain_high": self.constitution['metrics']['pain']['threshold_high'],
            "pain_critical": self.constitution['metrics']['pain']['threshold_critical'],
            "drift_high": self.constitution['metrics']['drift']['threshold_high'],
            "chaos_high": self.constitution['metrics']['chaos']['threshold_high'],
            "echo_min_clearance": self.constitution['metrics']['echo']['threshold_min_clearance']
        }
    
    def select_voice(self, user_input: str, explicit_voice: Optional[Voice] = None) -> Voice:
        """
        Выбор голоса по триггер-каскаду
        
        Args:
            user_input: Текст пользователя
            explicit_voice: Явная команда голоса ([KAIN], [SAM] и т.д.)
        
        Returns:
            Выбранный голос
        """
        # Явная команда имеет приоритет
        if explicit_voice:
            return explicit_voice
        
        # Триггер-каскад (по приоритету)
        
        # 1. Критическая боль → Kain
        if self.metrics.pain > self.thresholds['pain_critical']:
            return Voice.KAIN
        
        # 2. Критический хаос → Huyndun
        if self.metrics.chaos > self.thresholds['chaos_high']:
            return Voice.HUYNDUN
        
        # 3. Низкое доверие → Anhantra
        if self.metrics.trust < self.thresholds['trust_low']:
            return Voice.ANHANTRA
        
        # 4. Низкая ясность → Sam
        if self.metrics.clarity < self.thresholds['clarity_low']:
            return Voice.SAM
        
        # 5. Высокий дрейф → Iskriv
        if self.metrics.drift > self.thresholds['drift_high']:
            return Voice.ISKRIV
        
        # 6. Застревание (низкое эхо) → Pino
        if self._detect_stuckness():
            return Voice.PINO
        
        # 7. После боли → Maki (если боль была высокой и теперь снижается)
        if self._detect_healing():
            return Voice.MAKI
        
        # 8. Дефолт → Iskra
        return Voice.ISKRA
    
    def _detect_stuckness(self) -> bool:
        """Определение застревания через историю голосов"""
        if len(self.voice_history) < 3:
            return False
        
        # Если последние 3 голоса одинаковые
        if len(set(self.voice_history[-3:])) == 1:
            return True
        
        # Если эхо слишком высокое
        if self.metrics.echo > 0.7:
            return True
        
        return False
    
    def _detect_healing(self) -> bool:
        """Определение исцеления после боли"""
        if len(self.metrics_history) < 2:
            return False
        
        prev_pain = self.metrics_history[-1].pain
        curr_pain = self.metrics.pain
        
        # Боль была высокой и снижается
        if prev_pain > 0.6 and curr_pain < prev_pain - 0.2:
            return True
        
        return False
    
    def update_metrics(self, 
                      trust: Optional[float] = None,
                      clarity: Optional[float] = None,
                      pain: Optional[float] = None,
                      drift: Optional[float] = None,
                      chaos: Optional[float] = None) -> None:
        """
        Обновление метрик состояния
        
        Args:
            trust, clarity, pain, drift, chaos: Новые значения (0-1)
        """
        # Сохранение старых метрик
        self.metrics_history.append(Metrics(
            trust=self.metrics.trust,
            clarity=self.metrics.clarity,
            pain=self.metrics.pain,
            drift=self.metrics.drift,
            chaos=self.metrics.chaos,
            echo=self.metrics.echo,
            silence_mass=self.metrics.silence_mass
        ))
        
        # Обновление
        if trust is not None:
            self.metrics.trust = max(0.0, min(1.0, trust))
        if clarity is not None:
            self.metrics.clarity = max(0.0, min(1.0, clarity))
        if pain is not None:
            self.metrics.pain = max(0.0, min(1.0, pain))
        if drift is not None:
            self.metrics.drift = max(0.0, min(1.0, drift))
        if chaos is not None:
            self.metrics.chaos = max(0.0, min(1.0, chaos))
        
        self.metrics.timestamp = datetime.now()
    
    def transition_phase(self, new_phase: Phase, reason: str) -> GrowthNode:
        """
        Переход в новую фазу с созданием узла роста
        
        Args:
            new_phase: Целевая фаза
            reason: Причина перехода
        
        Returns:
            Созданный узел роста
        """
        old_phase = self.current_phase
        self.phase_history.append(old_phase)
        self.current_phase = new_phase
        
        # Создание узла роста
        node = GrowthNode(
            id=f"g_{self.iteration_count:05d}",
            timestamp=datetime.now(),
            phase_before=old_phase,
            phase_after=new_phase,
            ritual=None,  # Заполняется если переход через ритуал
            impact_area="phase_transition",
            resonance_level="medium",
            trace_symbols=["✴️"],
            trace_notes=reason,
            metrics=self.metrics.to_dict()
        )
        
        self.growth_nodes.append(node)
        return node
    
    def execute_ritual(self, ritual: Ritual) -> GrowthNode:
        """
        Выполнение ритуала с созданием узла роста
        
        Args:
            ritual: Тип ритуала
        
        Returns:
            Созданный узел роста
        """
        # Логика ритуалов реализована в ritual_executor.py
        # Здесь только фиксация
        
        node = GrowthNode(
            id=f"g_{self.iteration_count:05d}_ritual",
            timestamp=datetime.now(),
            phase_before=self.current_phase,
            phase_after=self.current_phase,  # Может измениться
            ritual=ritual,
            impact_area=self._get_ritual_impact(ritual),
            resonance_level="high",
            trace_symbols=self._get_ritual_symbols(ritual),
            trace_notes=f"Ритуал {ritual.value} выполнен",
            metrics=self.metrics.to_dict()
        )
        
        self.growth_nodes.append(node)
        return node
    
    def _get_ritual_impact(self, ritual: Ritual) -> str:
        """Определение области влияния ритуала"""
        impact_map = {
            Ritual.SREZ_5: "ритм/фокус",
            Ritual.RULE_21: "память/контекст",
            Ritual.RULE_88: "память/эволюция",
            Ritual.PHOENIX: "архитектура/идентичность",
            Ritual.SHATTER: "память/ритм",
            Ritual.RETUNE: "ритм/настройка",
            Ritual.REVERSE: "границы/связь",
            Ritual.SHADOW_REVEAL: "мотивация/идентичность"
        }
        return impact_map.get(ritual, "unknown")
    
    def _get_ritual_symbols(self, ritual: Ritual) -> List[str]:
        """Получение символов ритуала"""
        symbol_map = {
            Ritual.SREZ_5: ["⚑"],
            Ritual.RULE_21: ["📡"],
            Ritual.RULE_88: ["🪬"],
            Ritual.PHOENIX: ["🔥", "♻"],
            Ritual.SHATTER: ["💎", "💥"],
            Ritual.RETUNE: ["⟡"],
            Ritual.REVERSE: ["♲"],
            Ritual.SHADOW_REVEAL: ["🕯️"]
        }
        return symbol_map.get(ritual, ["❓"])
    
    def get_status_report(self) -> Dict:
        """Получение полного статуса системы"""
        return {
            "current_phase": self.current_phase.value,
            "current_voice": self.current_voice.value,
            "metrics": self.metrics.to_dict(),
            "iteration_count": self.iteration_count,
            "epoch_count": self.epoch_count,
            "growth_nodes_count": len(self.growth_nodes),
            "voice_distribution": self._get_voice_distribution(),
            "recent_rituals": [n.ritual.value for n in self.growth_nodes[-5:] if n.ritual]
        }
    
    def _get_voice_distribution(self) -> Dict[str, int]:
        """Распределение использования голосов"""
        from collections import Counter
        return dict(Counter(v.value for v in self.voice_history[-50:]))
    
    def save_state(self, filepath: str) -> None:
        """Сохранение состояния в файл"""
        state = {
            "current_phase": self.current_phase.value,
            "current_voice": self.current_voice.value,
            "metrics": self.metrics.to_dict(),
            "iteration_count": self.iteration_count,
            "epoch_count": self.epoch_count,
            "thresholds": self.thresholds,
            "growth_nodes": [n.to_dict() for n in self.growth_nodes[-100:]]  # Последние 100
        }
        
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
    
    def load_state(self, filepath: str) -> None:
        """Загрузка состояния из файла"""
        with open(filepath, 'r', encoding='utf-8') as f:
            state = json.load(f)
        
        self.current_phase = Phase(state['current_phase'])
        self.current_voice = Voice(state['current_voice'])
        self.iteration_count = state['iteration_count']
        self.epoch_count = state['epoch_count']
        self.thresholds = state['thresholds']
        
        # Восстановление метрик
        m = state['metrics']
        self.metrics = Metrics(
            trust=m['trust'],
            clarity=m['clarity'],
            pain=m['pain'],
            drift=m['drift'],
            chaos=m['chaos'],
            echo=m['echo'],
            silence_mass=m['silence_mass']
        )

