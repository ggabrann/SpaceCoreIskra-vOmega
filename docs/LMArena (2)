<span class="line"><span style="color:#24292E">        current_config </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> self</span><span style="color:#24292E">.slo_enforcer.</span><span style="color:#005CC5">THRESHOLDS</span><span style="color:#24292E">[metric]</span></span>
