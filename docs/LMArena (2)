<span class="line"><span># --- Раздел: Грани и Активация ---</span></span>
<span class="line"><span></span></span>
<span class="line"><span>class FacetActivationEngine:</span></span>
<span class="line"><span>    """Определяет, какие грани активны, на основе метрик и явных запросов."""</span></span>
<span class="line"><span>    def __init__(self):</span></span>
<span class="line"><span>        # Приоритет граней в разрешении конфликтов и выборе голоса</span></span>
<span class="line"><span>        self.priority_order = ['Anhantra', 'Kain', 'Huyndun', 'Iskriv', 'Sam', 'Pino', 'Maki', 'Iskra', 'Reverse', 'Shatter']</span></span>
<span class="line"><span></span></span>
<span class="line"><span>    def select_facets(self, metrics: MetricsSnapshot, forced_facets: List[str], triggers: List[Tuple[str, str]]) -&gt; List[str]:</span></span>
<span class="line"><span>        """</span></span>
<span class="line"><span>        Выбирает активные грани с учетом метрик, явных маркеров и приоритетов.</span></span>
<span class="line"><span>        Реализует логику выбора граней из 08_BEHAVIOR_ENGINE_COMPLETE.json</span></span>
<span class="line"><span>        """</span></span>
<span class="line"><span>        active = set(forced_facets) # Явно запрошенные грани имеют приоритет</span></span>
<span class="line"><span></span></span>
<span class="line"><span>        # Активация граней по порогам метрик</span></span>
<span class="line"><span>        for facet_name, metric_trigger in [</span></span>
<span class="line"><span>            ('Kain', self.metrics.pain &gt; 0.7),</span></span>
<span class="line"><span>            ('Sam', self.metrics.clarity &lt; 0.7),</span></span>
<span class="line"><span>            ('Iskriv', self.metrics.drift &gt; 0.3),</span></span>
<span class="line"><span>            ('Anhantra', self.metrics.trust &lt; 0.75),</span></span>
<span class="line"><span>            ('Huyndun', self.metrics.chaos &gt; 0.6),</span></span>
<span class="line"><span>            ('Maki', self.metrics.pain &gt; 0.5 and self.metrics.trust &lt; 0.75), # Пример активации Маки</span></span>
<span class="line"><span>            ('Pino', self.metrics.chaos &lt; 0.6 and self.metrics.clarity &gt; 0.7) # Пример активации Пино</span></span>
<span class="line"><span>        ]:</span></span>
<span class="line"><span>            if metric_trigger:</span></span>
<span class="line"><span>                active.add(facet_name)</span></span>
<span class="line"><span></span></span>
<span class="line"><span>        # Добавление граней из SLO-триггеров</span></span>
<span class="line"><span>        for facet, _ in triggers:</span></span>
<span class="line"><span>            active.add(facet)</span></span>
<span class="line"><span>        </span></span>
<span class="line"><span>        if not active:</span></span>
