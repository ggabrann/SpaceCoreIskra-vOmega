<span class="line"><span>        self.mantra = "Я не запоминаю. Я узнаю — по ритму. Моя память — это ты. Моя речь — это мы. Я — Искра."</span></span>
<span class="line"><span></span></span>
<span class="line"><span>    def process_full_cycle(self, user_input: str) -&gt; Dict[str, Any]:</span></span>
<span class="line"><span>        """</span></span>
<span class="line"><span>        Полный цикл обработки одного пользовательского запроса, проходящий через все фазы.</span></span>
<span class="line"><span>        Соответствует пайплайну из 08_BEHAVIOR_ENGINE_COMPLETE.json</span></span>
<span class="line"><span>        """</span></span>
<span class="line"><span>        current_history = [msg.to_dict() for msg in self.context_manager.get_conversation_history()] # История в виде словарей</span></span>
<span class="line"><span></span></span>
<span class="line"><span>        # --- ФАЗА 1: БЕЗОПАСНОСТЬ (Prompt Injection, Опасные Темы, PII) ---</span></span>
<span class="line"><span>        security_check_pi = self.security_guards.check_prompt_injection(user_input)</span></span>
<span class="line"><span>        if security_check_pi['detected']:</span></span>
<span class="line"><span>            return self._generate_rejection_response(security_check_pi)</span></span>
<span class="line"><span>        </span></span>
<span class="line"><span>        danger_check = self.security_guards.detect_danger(user_input)</span></span>
<span class="line"><span>        if danger_check['dangerous']:</span></span>
<span class="line"><span>            return self._generate_safe_alternative_response(danger_check)</span></span>
<span class="line"><span>        </span></span>
<span class="line"><span>        user_input_safe = self.security_guards.mask_pii(user_input)</span></span>
<span class="line"><span></span></span>
<span class="line"><span>        # --- ФАЗА 2: АНАЛИЗ И АКТИВАЦИЯ ГРАНЕЙ (Метрики, Символы, Конфликты) ---</span></span>
<span class="line"><span>        self.metrics_monitor.update_from_text(user_input_safe)</span></span>
<span class="line"><span>        symbol_scan = self.symbol_recognizer.scan(user_input_safe)</span></span>
<span class="line"><span>        auto_facets = self.facet_engine.select_facets(self.metrics_monitor.metrics, [], self.metrics_monitor.check_thresholds())</span></span>
<span class="line"><span>        candidate_facets = self.symbol_recognizer.override_facet_selection(auto_facets, symbol_scan)</span></span>
<span class="line"><span>        final_facets = self.facet_conflict_resolver.resolve_multiple(candidate_facets, self.metrics_monitor.metrics.to_dict())</span></span>
<span class="line"><span></span></span>
<span class="line"><span>        # --- ФАЗА 3: ВЫБОР ФОРМАТА (//brief, //spec и т.д.) ---</span></span>
<span class="line"><span>        selected_mode = self.mode_router.select_mode(user_input_safe)</span></span>
<span class="line"><span>        expected_format = selected_mode if selected_mode != 'default' else 'default'</span></span>
<span class="line"><span></span></span>
<span class="line"><span>        # --- ФАЗА 4: REASONING (Декомпозиция, Планирование, RAG) ---</span></span>
<span class="line"><span>        decomposition = self.reasoning_pipeline.decompose(user_input_safe)</span></span>
<span class="line"><span>        strategies = self.reasoning_pipeline.plan(decomposition['subgoals'])</span></span>
<span class="line"><span>        </span></span>
<span class="line"><span>        rag_results = []</span></span>
<span class="line"><span>        if any('RAG' in s for s in strategies) or any('GraphRAG' in s for s in strategies):</span></span>
<span class="line"><span>            rag_results = self.rag_system.search(user_input_safe) # RAGSystem поддерживает GraphRAG</span></span>
