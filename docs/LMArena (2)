<span class="line"><span style="color:#24292E">        expected_format </span><span style="color:#D73A49">=</span><span style="color:#24292E"> selected_mode </span><span style="color:#D73A49">if</span><span style="color:#24292E"> selected_mode </span><span style="color:#D73A49">!=</span><span style="color:#032F62"> 'default'</span><span style="color:#D73A49"> else</span><span style="color:#032F62"> 'default'</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D">        # --- ФАЗА 4: REASONING (Декомпозиция, Планирование, RAG) ---</span></span>
<span class="line"><span style="color:#24292E">        decomposition </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> self</span><span style="color:#24292E">.reasoning_pipeline.decompose(user_input_safe)</span></span>
<span class="line"><span style="color:#24292E">        strategies </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> self</span><span style="color:#24292E">.reasoning_pipeline.plan(decomposition[</span><span style="color:#032F62">'subgoals'</span><span style="color:#24292E">])</span></span>
<span class="line"><span style="color:#24292E">        </span></span>
<span class="line"><span style="color:#24292E">        rag_results </span><span style="color:#D73A49">=</span><span style="color:#24292E"> []</span></span>
<span class="line"><span style="color:#D73A49">        if</span><span style="color:#005CC5"> any</span><span style="color:#24292E">(</span><span style="color:#032F62">'RAG'</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> s </span><span style="color:#D73A49">for</span><span style="color:#24292E"> s </span><span style="color:#D73A49">in</span><span style="color:#24292E"> strategies) </span><span style="color:#D73A49">or</span><span style="color:#005CC5"> any</span><span style="color:#24292E">(</span><span style="color:#032F62">'GraphRAG'</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> s </span><span style="color:#D73A49">for</span><span style="color:#24292E"> s </span><span style="color:#D73A49">in</span><span style="color:#24292E"> strategies):</span></span>
