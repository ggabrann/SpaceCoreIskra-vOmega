<span class="line"><span></span></span>
<span class="line"><span>class MetricsMonitor:</span></span>
<span class="line"><span>    """Отслеживает и вычисляет метрики, ощущаемые как телесные давления."""</span></span>
<span class="line"><span>    def __init__(self):</span></span>
