<span class="line"><span style="color:#D73A49">    def</span><span style="color:#6F42C1"> check_thresholds</span><span style="color:#24292E">(self) -&gt; List[Tuple[</span><span style="color:#005CC5">str</span><span style="color:#24292E">, </span><span style="color:#005CC5">str</span><span style="color:#24292E">]]:</span></span>
