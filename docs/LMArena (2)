<span class="line"><span style="color:#D73A49">        if</span><span style="color:#005CC5"> len</span><span style="color:#24292E">(facets) </span><span style="color:#D73A49">&lt;=</span><span style="color:#005CC5"> 1</span><span style="color:#24292E">:</span></span>
