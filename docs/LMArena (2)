<span class="line"><span style="color:#032F62">        """Боль/напряжение: эмоциональная нагрузка"""</span></span>
<span class="line"><span style="color:#24292E">        score </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> 0.0</span></span>
