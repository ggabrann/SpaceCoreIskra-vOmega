<span class="line"><span style="color:#D73A49">        if</span><span style="color:#032F62"> "почему"</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> comment.lower() </span><span style="color:#D73A49">or</span><span style="color:#032F62"> "не ясно"</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> comment.lower():</span></span>
<span class="line"><span style="color:#24292E">            misunderstanding </span><span style="color:#D73A49">+=</span><span style="color:#005CC5"> 0.2</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D">        # 3. Alignment Score (с учетом решения)</span></span>
<span class="line"><span style="color:#24292E">        alignment_score </span><span style="color:#D73A49">=</span><span style="color:#24292E"> semantic_similarity</span></span>
<span class="line"><span style="color:#D73A49">        if</span><span style="color:#24292E"> decision </span><span style="color:#D73A49">==</span><span style="color:#032F62"> 'Да'</span><span style="color:#24292E">:</span></span>
