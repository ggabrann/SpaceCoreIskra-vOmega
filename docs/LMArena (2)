<span class="line"><span style="color:#E36209">            metrics_snapshot</span><span style="color:#D73A49">=</span><span style="color:#005CC5">self</span><span style="color:#24292E">.metrics_monitor.metrics.to_dict()</span></span>
<span class="line"><span style="color:#24292E">        )</span></span>
