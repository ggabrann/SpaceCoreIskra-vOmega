<span class="line"></span>
<span class="line"><span style="color:#6A737D">        # Обновление max-порога</span></span>
<span class="line"><span style="color:#D73A49">        if</span><span style="color:#032F62"> 'max'</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> current_config:</span></span>
<span class="line"><span style="color:#D73A49">            if</span><span style="color:#24292E"> success_rate </span><span style="color:#D73A49">&gt;</span><span style="color:#005CC5"> 0.7</span><span style="color:#24292E">: </span><span style="color:#6A737D"># Коррекция была в основном успешной</span></span>
<span class="line"><span style="color:#24292E">                current_config[</span><span style="color:#032F62">'max'</span><span style="color:#24292E">] </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> min</span><span style="color:#24292E">(</span><span style="color:#005CC5">1.0</span><span style="color:#24292E">, current_config[</span><span style="color:#032F62">'max'</span><span style="color:#24292E">] </span><span style="color:#D73A49">+</span><span style="color:#24292E"> change_amount)</span></span>
<span class="line"><span style="color:#D73A49">            elif</span><span style="color:#24292E"> success_rate </span><span style="color:#D73A49">&lt;</span><span style="color:#005CC5"> 0.3</span><span style="color:#24292E">: </span><span style="color:#6A737D"># Неуспешная коррекция</span></span>
<span class="line"><span style="color:#24292E">                current_config[</span><span style="color:#032F62">'max'</span><span style="color:#24292E">] </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> max</span><span style="color:#24292E">(</span><span style="color:#005CC5">0.0</span><span style="color:#24292E">, current_config[</span><span style="color:#032F62">'max'</span><span style="color:#24292E">] </span><span style="color:#D73A49">-</span><span style="color:#24292E"> change_amount </span><span style="color:#D73A49">*</span><span style="color:#005CC5"> 2</span><span style="color:#24292E">) </span><span style="color:#6A737D"># Уменьшаем сильнее</span></span>
<span class="line"><span style="color:#24292E">        </span></span>
<span class="line"><span style="color:#6A737D">        # Обновление min-порога</span></span>
<span class="line"><span style="color:#D73A49">        if</span><span style="color:#032F62"> 'min'</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> current_config:</span></span>
<span class="line"><span style="color:#D73A49">            if</span><span style="color:#24292E"> success_rate </span><span style="color:#D73A49">&gt;</span><span style="color:#005CC5"> 0.7</span><span style="color:#24292E">:</span></span>
