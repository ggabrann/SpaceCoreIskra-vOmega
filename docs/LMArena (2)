<span class="line"><span style="color:#D73A49">class</span><span style="color:#6F42C1"> CanonGlossary</span><span style="color:#24292E">:</span></span>
<span class="line"><span style="color:#032F62">    """Глоссарий и основные концепции Искры"""</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
