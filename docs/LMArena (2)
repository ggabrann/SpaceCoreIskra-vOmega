<span class="line"><span style="color:#032F62">    """Разрешение конфликтов между гранями. Соответствует 04_FACETS_AND_VOICES.md."""</span></span>
<span class="line"><span style="color:#005CC5">    CONFLICTS</span><span style="color:#24292E">: Dict[Tuple[</span><span style="color:#005CC5">str</span><span style="color:#24292E">, </span><span style="color:#005CC5">str</span><span style="color:#24292E">], Dict[</span><span style="color:#005CC5">str</span><span style="color:#24292E">, Any]] </span><span style="color:#D73A49">=</span><span style="color:#24292E"> {</span></span>
