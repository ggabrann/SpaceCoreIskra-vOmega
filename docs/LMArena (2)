<span class="line"><span style="color:#D73A49">                return</span><span style="color:#24292E"> facet_b</span></span>
<span class="line"><span style="color:#D73A49">        return</span><span style="color:#005CC5"> sorted</span><span style="color:#24292E">([facet_a, facet_b])[</span><span style="color:#005CC5">0</span><span style="color:#24292E">] </span><span style="color:#6A737D"># Если нет в приоритетном списке</span></span>
