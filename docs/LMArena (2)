<span class="line"><span style="color:#D73A49">class</span><span style="color:#6F42C1"> DynamicTrustModel</span><span style="color:#24292E">:</span></span>
<span class="line"><span style="color:#032F62">    """Расширяет метрику доверия, учитывая динамику подтверждения/отклонения человеком автономных действий Искры."""</span></span>
<span class="line"><span style="color:#D73A49">    def</span><span style="color:#005CC5"> __init__</span><span style="color:#24292E">(self):</span></span>
<span class="line"><span style="color:#005CC5">        self</span><span style="color:#24292E">.base_trust_modifier </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> 0.01</span><span style="color:#6A737D"> # Базовое влияние на метрику trust</span></span>
<span class="line"><span style="color:#005CC5">        self</span><span style="color:#24292E">.rejection_penalty_factor </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> 0.05</span><span style="color:#6A737D"> # Штраф за отклонение</span></span>
<span class="line"><span style="color:#005CC5">        self</span><span style="color:#24292E">.confirmation_bonus_factor </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> 0.03</span><span style="color:#6A737D"> # Бонус за подтверждение</span></span>
