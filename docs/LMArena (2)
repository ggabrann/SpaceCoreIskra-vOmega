<span class="line"><span style="color:#D73A49">    def</span><span style="color:#6F42C1"> resolve</span><span style="color:#24292E">(self, facet_a: </span><span style="color:#005CC5">str</span><span style="color:#24292E">, facet_b: </span><span style="color:#005CC5">str</span><span style="color:#24292E">, metrics: </span><span style="color:#005CC5">dict</span><span style="color:#24292E">) -&gt; </span><span style="color:#005CC5">str</span><span style="color:#24292E">:</span></span>
