<span class="line"><span style="color:#6A737D">        # 2. Уровень непонимания</span></span>
<span class="line"><span style="color:#24292E">        misunderstanding </span><span style="color:#D73A49">=</span><span style="color:#005CC5"> 0.0</span></span>
<span class="line"><span style="color:#D73A49">        if</span><span style="color:#24292E"> decision </span><span style="color:#D73A49">==</span><span style="color:#032F62"> 'Нет'</span><span style="color:#D73A49"> and</span><span style="color:#24292E"> semantic_similarity </span><span style="color:#D73A49">&gt;</span><span style="color:#005CC5"> 0.7</span><span style="color:#24292E">: </span><span style="color:#6A737D"># Отклонил, но семантически похоже -&gt; возможно, непонимание</span></span>
