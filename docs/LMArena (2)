<span class="line"><span>        self.history: List[MetricsSnapshot] = []</span></span>
<span class="line"><span></span></span>
<span class="line"><span>    def update_from_text(self, text: str):</span></span>
<span class="line"><span>        """Обновляет базовые метрики на основе текста. Реализация "Реагируй телом"."""</span></span>
<span class="line"><span>        word_count = len(text.split())</span></span>
<span class="line"><span>        </span></span>
<span class="line"><span>        # Обновление метрик на основе ключевых слов и длины сообщения</span></span>
<span class="line"><span>        if '∆' in text or 'больно' in text.lower() or 'тяжело' in text.lower(): self.metrics.pain = min(1.0, self.metrics.pain + 0.3)</span></span>
