<span class="line"><span style="color:#D73A49">    def</span><span style="color:#6F42C1"> process_input</span><span style="color:#24292E">(self, user_input: </span><span style="color:#005CC5">str</span><span style="color:#24292E">) -&gt; Dict[</span><span style="color:#005CC5">str</span><span style="color:#24292E">, Any]:</span></span>
<span class="line"><span style="color:#032F62">        """Полный цикл обработки одного пользовательского запроса."""</span></span>
