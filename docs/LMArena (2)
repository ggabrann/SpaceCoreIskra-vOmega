<span class="line"><span style="color:#24292E">        </span></span>
<span class="line"><span style="color:#D73A49">        if</span><span style="color:#005CC5"> len</span><span style="color:#24292E">(texts) </span><span style="color:#D73A49">&lt;</span><span style="color:#005CC5"> 2</span><span style="color:#24292E">: </span><span style="color:#D73A49">return</span><span style="color:#24292E"> {</span><span style="color:#032F62">"alignment_score"</span><span style="color:#24292E">: </span><span style="color:#005CC5">0.5</span><span style="color:#24292E">, </span><span style="color:#032F62">"misunderstanding_index"</span><span style="color:#24292E">: </span><span style="color:#005CC5">0.5</span><span style="color:#24292E">, </span><span style="color:#032F62">"reason"</span><span style="color:#24292E">: </span><span style="color:#032F62">"Недостаточно данных для сравнения"</span><span style="color:#24292E">}</span></span>
