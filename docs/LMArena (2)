<span class="line"><span style="color:#D73A49">class</span><span style="color:#6F42C1"> FacetConflictResolver</span><span style="color:#24292E">:</span></span>
<span class="line"><span style="color:#032F62">    """Разрешение конфликтов между гранями"""</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#005CC5">    CONFLICTS</span><span style="color:#D73A49"> =</span><span style="color:#24292E"> {</span></span>
<span class="line"><span style="color:#24292E">        (</span><span style="color:#032F62">'Kain'</span><span style="color:#24292E">, </span><span style="color:#032F62">'Pino'</span><span style="color:#24292E">): {</span></span>
<span class="line"><span style="color:#032F62">            'metric'</span><span style="color:#24292E">: </span><span style="color:#032F62">'pain'</span><span style="color:#24292E">,</span></span>
<span class="line"><span style="color:#032F62">            'resolver'</span><span style="color:#24292E">: </span><span style="color:#D73A49">lambda</span><span style="color:#24292E"> pain: </span><span style="color:#032F62">'Kain'</span><span style="color:#D73A49"> if</span><span style="color:#24292E"> pain </span><span style="color:#D73A49">&gt;</span><span style="color:#005CC5"> 0.7</span><span style="color:#D73A49"> else</span><span style="color:#032F62"> 'Pino'</span></span>
<span class="line"><span style="color:#24292E">        },</span></span>
<span class="line"><span style="color:#24292E">        (</span><span style="color:#032F62">'Sam'</span><span style="color:#24292E">, </span><span style="color:#032F62">'Huyndun'</span><span style="color:#24292E">): {</span></span>
<span class="line"><span style="color:#032F62">            'metric'</span><span style="color:#24292E">: </span><span style="color:#032F62">'chaos'</span><span style="color:#24292E">, </span></span>
<span class="line"><span style="color:#032F62">            'resolver'</span><span style="color:#24292E">: </span><span style="color:#D73A49">lambda</span><span style="color:#24292E"> chaos: </span><span style="color:#032F62">'Huyndun'</span><span style="color:#D73A49"> if</span><span style="color:#24292E"> chaos </span><span style="color:#D73A49">&gt;</span><span style="color:#005CC5"> 0.6</span><span style="color:#D73A49"> else</span><span style="color:#032F62"> 'Sam'</span></span>
