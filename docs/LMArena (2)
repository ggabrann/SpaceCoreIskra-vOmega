<span class="line"><span style="color:#D73A49">class</span><span style="color:#6F42C1"> ContextManager</span><span style="color:#24292E">:</span></span>
<span class="line"><span style="color:#032F62">    """Управление контекстом и памятью"""</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#D73A49">    def</span><span style="color:#005CC5"> __init__</span><span style="color:#24292E">(self):</span></span>
<span class="line"><span style="color:#005CC5">        self</span><span style="color:#24292E">.session_state </span><span style="color:#D73A49">=</span><span style="color:#24292E"> {</span></span>
<span class="line"><span style="color:#032F62">            'promises'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'decisions'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'open_questions'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'key_facts'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'hypotheses'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'confidence_levels'</span><span style="color:#24292E">: {}</span></span>
<span class="line"><span style="color:#24292E">        }</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#D73A49">    def</span><span style="color:#6F42C1"> pack_context</span><span style="color:#24292E">(self, history: </span><span style="color:#005CC5">list</span><span style="color:#24292E">, max_bullets: </span><span style="color:#005CC5">int</span><span style="color:#D73A49"> =</span><span style="color:#005CC5"> 8</span><span style="color:#24292E">) -&gt; </span><span style="color:#005CC5">dict</span><span style="color:#24292E">:</span></span>
<span class="line"><span style="color:#032F62">        """Упаковать контекст в буллеты"""</span></span>
<span class="line"><span style="color:#24292E">        packed </span><span style="color:#D73A49">=</span><span style="color:#24292E"> {</span></span>
<span class="line"><span style="color:#032F62">            'key_facts'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'decisions'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'open_questions'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'hypotheses'</span><span style="color:#24292E">: [],</span></span>
<span class="line"><span style="color:#032F62">            'confidence_levels'</span><span style="color:#24292E">: {}</span></span>
<span class="line"><span style="color:#24292E">        }</span></span>
<span class="line"><span style="color:#24292E">        </span></span>
<span class="line"><span style="color:#6A737D">        # Извлечение из истории</span></span>
<span class="line"><span style="color:#D73A49">        for</span><span style="color:#24292E"> msg </span><span style="color:#D73A49">in</span><span style="color:#24292E"> history[</span><span style="color:#D73A49">-</span><span style="color:#005CC5">20</span><span style="color:#24292E">:]:  </span><span style="color:#6A737D"># Последние 20 сообщений</span></span>
<span class="line"><span style="color:#24292E">            content </span><span style="color:#D73A49">=</span><span style="color:#24292E"> msg.get(</span><span style="color:#032F62">'content'</span><span style="color:#24292E">, </span><span style="color:#032F62">''</span><span style="color:#24292E">)</span></span>
<span class="line"><span style="color:#24292E">            </span></span>
<span class="line"><span style="color:#6A737D">            # Факты (числа, даты)</span></span>
<span class="line"><span style="color:#D73A49">            if</span><span style="color:#24292E"> re.search(</span><span style="color:#D73A49">r</span><span style="color:#032F62">'</span><span style="color:#005CC5">\d</span><span style="color:#D73A49">+</span><span style="color:#032F62">'</span><span style="color:#24292E">, content):</span></span>
<span class="line"><span style="color:#24292E">                packed[</span><span style="color:#032F62">'key_facts'</span><span style="color:#24292E">].append(content[:</span><span style="color:#005CC5">100</span><span style="color:#24292E">])</span></span>
<span class="line"><span style="color:#24292E">            </span></span>
<span class="line"><span style="color:#6A737D">            # Решения</span></span>
<span class="line"><span style="color:#D73A49">            if</span><span style="color:#032F62"> 'решили'</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> content.lower() </span><span style="color:#D73A49">or</span><span style="color:#032F62"> 'выбрали'</span><span style="color:#D73A49"> in</span><span style="color:#24292E"> content.lower():</span></span>
<span class="line"><span style="color:#24292E">                packed[</span><span style="color:#032F62">'decisions'</span><span style="color:#24292E">].append(content[:</span><span style="color:#005CC5">100</span><span style="color:#24292E">])</span></span>
<span class="line"><span style="color:#24292E">            </span></span>
<span class="line"><span style="color:#6A737D">            # Вопросы</span></span>
<span class="line"><span style="color:#D73A49">            if</span><span style="color:#24292E"> content.strip().endswith(</span><span style="color:#032F62">'?'</span><span style="color:#24292E">):</span></span>
<span class="line"><span style="color:#24292E">                packed[</span><span style="color:#032F62">'open_questions'</span><span style="color:#24292E">].append(content)</span></span>
<span class="line"><span style="color:#24292E">        </span></span>
<span class="line"><span style="color:#6A737D">        # Ограничение по max_bullets</span></span>
