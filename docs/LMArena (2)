<span class="line"><span style="color:#D73A49">        for</span><span style="color:#24292E"> pattern </span><span style="color:#D73A49">in</span><span style="color:#005CC5"> self</span><span style="color:#24292E">.</span><span style="color:#005CC5">CLARITY_SIGNALS</span><span style="color:#24292E">[</span><span style="color:#032F62">'high'</span><span style="color:#24292E">]:</span></span>
