<span class="line"><span style="color:#D73A49">class</span><span style="color:#6F42C1"> FacetActivationEngine</span><span style="color:#24292E">:</span></span>
<span class="line"><span style="color:#032F62">    """Определяет, какие грани активны, на основе метрик и явных запросов."""</span></span>
