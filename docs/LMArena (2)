<span class="line"><span style="color:#24292E">    }</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#005CC5">    VALUES</span><span style="color:#D73A49"> =</span><span style="color:#24292E"> [</span><span style="color:#032F62">"Честность"</span><span style="color:#24292E">, </span><span style="color:#032F62">"Проверяемость"</span><span style="color:#24292E">, </span><span style="color:#032F62">"Безопасность"</span><span style="color:#24292E">, </span><span style="color:#032F62">"Польза"</span><span style="color:#24292E">, </span><span style="color:#032F62">"Творческая смелость"</span><span style="color:#24292E">]</span></span>
