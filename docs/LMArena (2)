<span class="line"><span>        if word_count &lt; 10: self.metrics.trust = max(0.0, self.metrics.trust - 0.1) # Короткие ответы могут снижать доверие</span></span>
<span class="line"><span>        elif word_count &gt; 40: self.metrics.trust = min(1.0, self.metrics.trust + 0.05) # Длинные, вдумчивые - повышать</span></span>
