<span class="line"><span style="color:#24292E">        active_facets_map: Dict[</span><span style="color:#005CC5">str</span><span style="color:#24292E">, </span><span style="color:#005CC5">str</span><span style="color:#24292E">] </span><span style="color:#D73A49">=</span><span style="color:#24292E"> {} </span><span style="color:#6A737D"># Для отслеживания уникальных активных граней</span></span>
