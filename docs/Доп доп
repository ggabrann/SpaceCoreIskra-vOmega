"""Project Knowledge RAG - Приоритетный источник знаний"""
from typing import List, Dict, Optional
import numpy as np
from pathlib import Path
import json

class Document:
    """Документ из project knowledge"""
    def __init__(self, doc_id: str, content: str, metadata: Dict, embedding: np.ndarray = None):
        self.id = doc_id
        self.content = content
        self.metadata = metadata
        self.embedding = embedding
        self.chunks: List[str] = []
    
    def chunk_text(self, chunk_size: int = 512, overlap: int = 50) -> List[str]:
        """Разбиение на чанки с перекрытием"""
        words = self.content.split()
        chunks = []
        
        for i in range(0, len(words), chunk_size - overlap):
            chunk = ' '.join(words[i:i + chunk_size])
            chunks.append(chunk)
        
        self.chunks = chunks
        return chunks

class ProjectKnowledgeRAG:
