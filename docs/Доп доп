"""Holographic Recall - Голографическая память через проекции"""
from typing import List, Dict, Optional, Tuple
import numpy as np
from datetime import datetime
from dataclasses import dataclass

@dataclass
class StateSnapshot:
    """Снимок состояния системы"""
    id: str
    timestamp: datetime
    phase: str
    voice: str
    metrics: Dict[str, float]
    context_summary: str
    symbols_active: List[str]
    projection: np.ndarray  # Компактная проекция состояния
    
    def to_dict(self) -> Dict:
        return {
            "id": self.id,
            "timestamp": self.timestamp.isoformat(),
            "phase": self.phase,
            "voice": self.voice,
            "metrics": self.metrics,
            "context_summary": self.context_summary,
            "symbols_active": self.symbols_active
        }

class HolographicRecall:
    """
    Голографическая память - сжатие состояний в низкоразмерные проекции
    для быстрого поиска похожих прошлых состояний
    """
    
    def __init__(self, projection_dim: int = 32):
        self.projection_dim = projection_dim
        self.snapshots: List[StateSnapshot] = []
        self.projection_matrix: Optional[np.ndarray] = None
        
    def create_snapshot(self, state: Dict) -> StateSnapshot:
        """
        Создание снимка текущего состояния
        
        Args:
            state: Полное состояние системы
        
        Returns:
            Снимок с проекцией
        """
        # Векторизация состояния
        state_vector = self._vectorize_state(state)
        
        # Создание или обновление матрицы проекции
        if self.projection_matrix is None:
            self._init_projection_matrix(len(state_vector))
        
        # Проекция в низкоразмерное пространство
        projection = self.projection_matrix @ state_vector
        
        snapshot = StateSnapshot(
            id=f"snap_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
            timestamp=datetime.now(),
            phase=state.get('phase', 'unknown'),
            voice=state.get('voice', 'unknown'),
            metrics=state.get('metrics', {}),
            context_summary=state.get('context_summary', '')[:200],
            symbols_active=state.get('symbols_active', []),
            projection=projection
        )
        
        self.snapshots.append(snapshot)
        return snapshot
    
    def find_similar_states(self, current_state: Dict, 
                           top_k: int = 3,
                           min_similarity: float = 0.5) -> List[Tuple[StateSnapshot, float]]:
        """
        Поиск похожих прошлых состояний
        
        Args:
            current_state: Текущее состояние
            top_k: Количество результатов
            min_similarity: Минимальная схожесть
        
        Returns:
            Список (snapshot, similarity_score)
        """
        if not self.snapshots:
            return []
        
        # Проекция текущего состояния
        current_vector = self._vectorize_state(current_state)
        current_projection = self.projection_matrix @ current_vector
        
        # Расчёт схожести со всеми снимками
        similarities = []
        for snapshot in self.snapshots:
            similarity = self._cosine_similarity(current_projection, snapshot.projection)
            if similarity >= min_similarity:
                similarities.append((snapshot, similarity))
        
        # Сортировка по схожести
        similarities.sort(key=lambda x: x[1], reverse=True)
        return similarities[:top_k]
    
    def recall_behavioral_shifts(self, similar_snapshot: StateSnapshot) -> Dict:
        """
        Извлечение поведенческих сдвигов из похожего снимка
        
        Args:
            similar_snapshot: Похожий снимок из прошлого
        
        Returns:
            Рекомендации по сдвигам
        """
        # Анализируем что было сделано после этого снимка
        snapshot_index = self.snapshots.index(similar_snapshot)
        
        if snapshot_index < len(self.snapshots) - 1:
            next_snapshot = self.snapshots[snapshot_index + 1]
            
            shifts = {
                "phase_shift": {
                    "from": similar_snapshot.phase,
                    "to": next_snapshot.phase
                },
                "voice_shift": {
                    "from": similar_snapshot.voice,
                    "to": next_snapshot.voice
                },
                "metrics_delta": {
                    key: next_snapshot.metrics.get(key, 0) - similar_snapshot.metrics.get(key, 0)
                    for key in similar_snapshot.metrics
                },
                "new_symbols": list(set(next_snapshot.symbols_active) - set(similar_snapshot.symbols_active))
            }
            
            return shifts
        
        return {"note": "Нет данных о последующих действиях"}
    
    def _vectorize_state(self, state: Dict) -> np.ndarray:
        """
        Векторизация состояния для проекции
        
        Преобразует сложное состояние в числовой вектор
        """
        vector_parts = []
        
        # Метрики (7 значений)
        metrics = state.get('metrics', {})
        vector_parts.extend([
            metrics.get('trust', 0.5),
            metrics.get('clarity', 0.5),
            metrics.get('pain', 0.5),
            metrics.get('drift', 0.5),
            metrics.get('chaos', 0.5),
            metrics.get('echo', 0.5),
            metrics.get('silence_mass', 0.5)
        ])
        
        # Фаза (one-hot encoding для 8 фаз)
        phases = ['darkness', 'transition', 'clarity', 'echo', 
                 'silence', 'experiment', 'dissolution', 'realization']
        phase_encoding = [1.0 if state.get('phase') == p else 0.0 for p in phases]
        vector_parts.extend(phase_encoding)
        
        # Голос (one-hot encoding для 8 голосов)
        voices = ['kain', 'pino', 'sam', 'anhantra', 
                 'huyndun', 'iskriv', 'maki', 'iskra']
        voice_encoding = [1.0 if state.get('voice') == v else 0.0 for v in voices]
        vector_parts.extend(voice_encoding)
        
        # Символы (бинарный вектор присутствия)
        all_symbols = ['⚑', '☉', '∆', '≈', '🜃', '⟡', '🪞', '🤗', 
                      '😏', '🤭', '🌸', '✴️', '📡', '🕯️', '🜂']
        symbols_active = state.get('symbols_active', [])
        symbol_encoding = [1.0 if s in symbols_active else 0.0 for s in all_symbols]
        vector_parts.extend(symbol_encoding)
        
        return np.array(vector_parts)
    
    def _init_projection_matrix(self, input_dim: int) -> None:
        """
        Инициализация матрицы проекции (random projection)
        
        Использует Johnson-Lindenstrauss lemma для сохранения расстояний
        """
        # Random projection matrix
        self.projection_matrix = np.random.randn(self.projection_dim, input_dim)
        # Нормализация
        self.projection_matrix /= np.linalg.norm(self.projection_matrix, axis=0)
    
    def _cosine_similarity(self, vec1: np.ndarray, vec2: np.ndarray) -> float:
        """Косинусное сходство"""
        return np.dot(vec1, vec2) / (np.linalg.norm(vec1) * np.linalg.norm(vec2))
    
    def export_hologram(self, output_path: str) -> None:
        """Экспорт голограммы памяти"""
        import json
        
        data = {
            "projection_dim": self.projection_dim,
            "snapshots_count": len(self.snapshots),
            "snapshots": [s.to_dict() for s in self.snapshots[-50:]]  # Последние 50
        }
        
        with open(output_path, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
