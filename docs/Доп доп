            try:
                data = np.load(file_path, allow_pickle=True)
                doc_id = file_path.stem
                
                self.vectors[doc_id] = data['vector']
                self.metadata[doc_id] = json.loads(str(data['metadata']))
            except Exception as e:
                print(f"Error loading {file_path}: {e}")
    
