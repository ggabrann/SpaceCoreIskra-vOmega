"""Vector Store - Хранилище векторных эмбеддингов"""
from typing import List, Dict, Optional, Tuple
import numpy as np
import json
from pathlib import Path

class VectorStore:
    """
    Векторное хранилище для эмбеддингов документов
    Поддерживает CRUD операции и быстрый поиск по схожести
    """
    
    def __init__(self, store_path: str = "vector_store/", dimension: int = 768):
        self.store_path = Path(store_path)
        self.store_path.mkdir(parents=True, exist_ok=True)
        self.dimension = dimension
        
        # In-memory индекс
        self.vectors: Dict[str, np.ndarray] = {}
        self.metadata: Dict[str, Dict] = {}
        
        self.load()
    
    def add(self, doc_id: str, vector: np.ndarray, metadata: Dict) -> None:
        """
        Добавление вектора
        
        Args:
            doc_id: Уникальный ID документа
            vector: Эмбеддинг вектор
            metadata: Метаданные документа
        """
        if vector.shape[0] != self.dimension:
            raise ValueError(f"Vector dimension mismatch: {vector.shape[0]} != {self.dimension}")
        
        self.vectors[doc_id] = vector
        self.metadata[doc_id] = metadata
        
        # Персистентность
        self._persist(doc_id, vector, metadata)
    
    def search(self, query_vector: np.ndarray, 
              top_k: int = 10,
              filter_metadata: Optional[Dict] = None) -> List[Tuple[str, float, Dict]]:
        """
        Поиск ближайших векторов
        
        Args:
            query_vector: Вектор запроса
            top_k: Количество результатов
            filter_metadata: Фильтр по метаданным
        
        Returns:
            Список (doc_id, similarity, metadata)
        """
        if not self.vectors:
            return []
        
        results = []
        
        for doc_id, vector in self.vectors.items():
            # Применение фильтра метаданных
            if filter_metadata:
                if not self._matches_filter(self.metadata[doc_id], filter_metadata):
                    continue
            
            # Косинусное сходство
            similarity = self._cosine_similarity(query_vector, vector)
            results.append((doc_id, similarity, self.metadata[doc_id]))
        
        # Сортировка по схожести
        results.sort(key=lambda x: x[1], reverse=True)
        return results[:top_k]
    
    def get(self, doc_id: str) -> Optional[Tuple[np.ndarray, Dict]]:
        """Получение вектора и метаданных по ID"""
        if doc_id not in self.vectors:
            return None
        return (self.vectors[doc_id], self.metadata[doc_id])
    
    def delete(self, doc_id: str) -> bool:
        """Удаление вектора"""
        if doc_id in self.vectors:
            del self.vectors[doc_id]
            del self.metadata[doc_id]
            
            # Удаление файла
            file_path = self.store_path / f"{doc_id}.npz"
            if file_path.exists():
                file_path.unlink()
            
            return True
        return False
    
    def update_metadata(self, doc_id: str, metadata: Dict) -> bool:
        """Обновление метаданных"""
        if doc_id in self.metadata:
            self.metadata[doc_id].update(metadata)
            # Пересохранение
            self._persist(doc_id, self.vectors[doc_id], self.metadata[doc_id])
            return True
        return False
    
    def get_stats(self) -> Dict:
        """Статистика хранилища"""
        return {
            "total_vectors": len(self.vectors),
            "dimension": self.dimension,
            "storage_path": str(self.store_path),
            "memory_size_mb": sum(v.nbytes for v in self.vectors.values()) / (1024**2)
        }
    
    def _cosine_similarity(self, vec1: np.ndarray, vec2: np.ndarray) -> float:
        """Косинусное сходство"""
        return np.dot(vec1, vec2) / (np.linalg.norm(vec1) * np.linalg.norm(vec2))
    
    def _matches_filter(self, metadata: Dict, filter_dict: Dict) -> bool:
        """Проверка соответствия метаданных фильтру"""
        for key, value in filter_dict.items():
            if key not in metadata or metadata[key] != value:
                return False
        return True
    
    def _persist(self, doc_id: str, vector: np.ndarray, metadata: Dict) -> None:
        """Сохранение вектора на диск"""
        file_path = self.store_path / f"{doc_id}.npz"
        np.savez_compressed(
            file_path,
            vector=vector,
            metadata=json.dumps(metadata, ensure_ascii=False)
        )
    
