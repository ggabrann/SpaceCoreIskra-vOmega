            extract_text: Извлекать только текст
        
        Returns:
            Содержимое страницы
        """
        # Проверка кэша
        if url in self.fetch_cache:
            return {
                "url": url,
                "content": self.fetch_cache[url],
                "cached": True
            }
        
        # В реальности: вызов web_fetch tool
        # Заглушка
        content = f"Содержимое {url}"
        
        # Кэширование
        self.fetch_cache[url] = content
        
        return {
            "url": url,
            "content": content,
            "cached": False,
            "timestamp": datetime.now().isoformat()
        }
    
    def search_and_fetch(self, query: str, 
                        top_urls: int = 3) -> List[Dict]:
        """
        Поиск + получение полного содержимого топ результатов
        
        Паттерн: search → fetch URLs → extract content
        
