"""Retrieval Engine - Движок извлечения с гибридным поиском"""
from typing import List, Dict, Optional
from project_knowledge_rag import ProjectKnowledgeRAG
from graph_rag import GraphRAG
from vector_store import VectorStore

class RetrievalEngine:
    """
    Унифицированный движок извлечения
    Комбинирует: project knowledge > graph > vector > web
    """
    
    def __init__(self):
        self.project_rag = ProjectKnowledgeRAG()
        self.graph_rag = GraphRAG()
        self.vector_store = VectorStore()
        self.search_history: List[Dict] = []
    
    def retrieve(self, query: str, 
                strategy: str = "hybrid",
                top_k: int = 5) -> Dict:
        """
        Извлечение релевантной информации
        
        Args:
            query: Запрос пользователя
            strategy: Стратегия поиска (project_only|graph|vector|hybrid)
            top_k: Количество результатов
        
        Returns:
            Результаты с источниками
        """
        results = {
            "query": query,
            "strategy": strategy,
            "sources": []
        }
        
        # КРИТИЧНО: project_knowledge ВСЕГДА первым
        project_results = self.project_rag.search(query, top_k=top_k)
        if project_results:
            results["sources"].extend([
                {
                    "type": "project_knowledge",
                    "content": r['content'],
                    "similarity": r['similarity'],
                    "metadata": r['metadata'],
                    "priority": "highest"
                }
                for r in project_results
            ])
        
        # Если недостаточно из project knowledge - дополняем
        if len(results["sources"]) < top_k:
            if strategy in ["graph", "hybrid"]:
                graph_results = self.graph_rag.query_graph(query, max_hops=2)
                results["sources"].extend([
                    {
                        "type": "graph",
                        "content": self._format_graph_result(r),
                        "relevance": r['relevance'],
                        "priority": "high"
                    }
                    for r in graph_results[:top_k - len(results["sources"])]
                ])
            
            if strategy in ["vector", "hybrid"]:
                # Генерация query embedding (заглушка)
                query_vec = self._create_query_embedding(query)
                vector_results = self.vector_store.search(query_vec, top_k=top_k)
                results["sources"].extend([
                    {
                        "type": "vector",
                        "doc_id": doc_id,
                        "similarity": sim,
                        "metadata": meta,
                        "priority": "medium"
                    }
                    for doc_id, sim, meta in vector_results[:top_k - len(results["sources"])]
                ])
        
        # Логирование поиска
        self.search_history.append({
            "query": query,
            "strategy": strategy,
            "results_count": len(results["sources"]),
            "timestamp": "2025-10-10T22:44:00Z"
        })
        
        return results
    
    def get_full_context(self, query: str, max_tokens: int = 4000) -> str:
        """
        Получение полного контекста для ответа
        
        Args:
            query: Запрос
            max_tokens: Максимум токенов контекста
        
        Returns:
            Объединённый контекст
        """
        results = self.retrieve(query, strategy="hybrid", top_k=10)
        
        context_parts = []
        current_tokens = 0
        
        # Сортировка по приоритету
        priority_order = {"highest": 0, "high": 1, "medium": 2, "low": 3}
        sorted_sources = sorted(
            results["sources"],
            key=lambda x: priority_order.get(x.get("priority", "low"), 3)
        )
        
        for source in sorted_sources:
            content = source.get('content', '')
            # Примерная оценка токенов (1 токен ≈ 4 символа)
            tokens = len(content) // 4
            
            if current_tokens + tokens > max_tokens:
                break
            
            context_parts.append(f"## Источник: {source['type']}\n{content}\n")
            current_tokens += tokens
        
        return "\n".join(context_parts)
    
    def _format_graph_result(self, graph_result: Dict) -> str:
        """Форматирование результата из графа"""
        root = graph_result['root_entity']
        subgraph = graph_result['subgraph']
        
        formatted = f"Сущность: {root['name']} ({root['type']})\n"
        formatted += f"Связей: {len(subgraph['relationships'])}\n"
        
        # Первые 3 связанные сущности
        for entity in subgraph['entities'][:3]:
            formatted += f"- {entity['name']}\n"
        
        return formatted
    
    def _create_query_embedding(self, query: str):
        """Создание эмбеддинга запроса (заглушка)"""
        import hashlib
        hash_obj = hashlib.md5(query.encode())
        hash_int = int(hash_obj.hexdigest(), 16)
        import numpy as np
        np.random.seed(hash_int % (2**32))
        return np.random.randn(768)
