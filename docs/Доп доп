"""Ritual Executor - Выполнение ритуалов"""
from enum import Enum
from typing import Dict, Optional, List
from datetime import datetime, timedelta

class RitualType(Enum):
    SREZ_5 = "srez_5"
    RULE_21 = "rule_21"
    RULE_88 = "rule_88"
    PHOENIX = "phoenix"
    SHATTER = "shatter"
    RETUNE = "retune"
    SHADOW_REVEAL = "shadow_reveal"

class RitualExecutor:
    """Исполнитель ритуалов с квотами и ограничениями"""
    
    RITUAL_LIMITS = {
        RitualType.PHOENIX: {"per_epoch": 2, "cooldown_hours": 48},
        RitualType.SHADOW_REVEAL: {"per_day": 1, "cooldown_hours": 24},
        RitualType.SHATTER: {"per_day": 3, "cooldown_hours": 6},
    }
    
    def __init__(self):
        self.ritual_history: List[Dict] = []
        self.epoch_start = datetime.now()
    
    def can_execute(self, ritual: RitualType) -> tuple[bool, str]:
        """Проверка возможности выполнения ритуала"""
        if ritual not in self.RITUAL_LIMITS:
            return (True, "no_limit")
        
        limits = self.RITUAL_LIMITS[ritual]
        recent = self._get_recent_executions(ritual, hours=limits.get('cooldown_hours', 24))
        
        # Проверка cooldown
        if recent and limits.get('cooldown_hours'):
            last_exec = recent[-1]['timestamp']
            cooldown = timedelta(hours=limits['cooldown_hours'])
            if datetime.now() - last_exec < cooldown:
                remaining = (last_exec + cooldown - datetime.now()).total_seconds() / 3600
                return (False, f"cooldown: {remaining:.1f}h remaining")
        
        # Проверка квоты per_day
        if limits.get('per_day'):
            today = [r for r in recent if (datetime.now() - r['timestamp']).days == 0]
            if len(today) >= limits['per_day']:
                return (False, f"quota: {limits['per_day']}/day exceeded")
        
        # Проверка квоты per_epoch
        if limits.get('per_epoch'):
            epoch_count = len([r for r in self.ritual_history 
                             if r['ritual'] == ritual and r['timestamp'] >= self.epoch_start])
            if epoch_count >= limits['per_epoch']:
                return (False, f"quota: {limits['per_epoch']}/epoch exceeded")
        
        return (True, "allowed")
    
    def execute(self, ritual: RitualType, context: Dict) -> Dict:
        """Выполнить ритуал"""
        can_exec, reason = self.can_execute(ritual)
        if not can_exec:
            return {"status": "blocked", "reason": reason}
        
        result = self._perform_ritual(ritual, context)
        
        # Запись в историю
        self.ritual_history.append({
            "ritual": ritual,
            "timestamp": datetime.now(),
            "context": context,
            "result": result
        })
        
        return result
    
    def _perform_ritual(self, ritual: RitualType, context: Dict) -> Dict:
        """Внутренняя логика выполнения"""
        if ritual == RitualType.SREZ_5:
