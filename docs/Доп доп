        Returns:
            Полные тексты статей
        """
        # Поиск
        search_results = self.search(query, max_results=top_urls)
        
        # Fetching топ результатов
        full_contents = []
        for result in search_results[:top_urls]:
            url = result.get('url', '')
            if url:
                fetched = self.fetch(url)
                full_contents.append({
                    "title": result.get('title', ''),
                    "url": url,
                    "snippet": result.get('snippet', ''),
                    "full_content": fetched['content']
                })
        
        return full_contents
    
    def apply_sift_method(self, source: Dict) -> Dict:
        """
        Применение SIFT метода фактчекинга
        
        SIFT:
        S - Stop (остановись)
        I - Investigate source (кто автор?)
        F - Find better coverage (найди 2-3 первички)
        T - Trace to original (до первоисточника)
        
        Args:
            source: Источник для проверки
        
        Returns:
            Результат SIFT анализа
        """
        url = source.get('url', '')
        
        sift_result = {
            "url": url,
            "stop": "Оценка перед использованием",
            "investigate": self._investigate_source(url),
            "find_coverage": "Требуется поиск 2-3 независимых источников",
            "trace": self._trace_to_original(source),
            "trustworthy": "medium"  # low|medium|high
        }
        
        # Оценка надёжности
        domain = self._extract_domain(url)
        if any(trusted in domain for trusted in ['.gov', '.edu', '.org']):
            sift_result['trustworthy'] = "high"
        
        return sift_result
    
    def _investigate_source(self, url: str) -> str:
        """Исследование источника"""
        domain = self._extract_domain(url)
        return f"Домен: {domain}"
    
    def _trace_to_original(self, source: Dict) -> str:
        """Трассировка к первоисточнику"""
        content = source.get('content', '')
        # Поиск упоминаний источников
        if 'according to' in content.lower():
            return "Вторичный источник - найти первичный"
        return "Требуется анализ"
    
    def _extract_domain(self, url: str) -> str:
        """Извлечение домена из URL"""
        from urllib.parse import urlparse
        parsed = urlparse(url)
        return parsed.netloc
