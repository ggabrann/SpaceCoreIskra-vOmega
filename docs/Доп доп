"""Voice Selector - Детальная логика выбора голоса"""
from typing import Optional, List, Tuple
from dataclasses import dataclass
import re

@dataclass
class VoiceContext:
    """Контекст для выбора голоса"""
    user_text: str
    pain: float
    trust: float
    clarity: float
    drift: float
    chaos: float
    echo: float
    voice_history: List[str]
    explicit_command: Optional[str] = None

class VoiceSelector:
    """Расширенная логика выбора голоса с детекцией паттернов"""
    
    COMMAND_PATTERNS = {
        'KAIN': r'\[KAIN\]',
        'SAM': r'\[SAM\]',
        'ANH': r'\[ANH\]',
        'PINO': r'\[PINO\]',
        'ISKRIV': r'\[ISKRIV\]',
        'MAKI': r'\[MAKI\]',
    }
    
    PAIN_INDICATORS = [
        'больно', 'страдаю', 'невыносимо', 'разрушает',
        'умираю', 'конец', 'провал', 'катастрофа'
    ]
    
    LIE_INDICATORS = [
        'на самом деле нет', 'притворяюсь', 'ложь',
        'скрываю', 'не признаюсь'
    ]
    
    def __init__(self):
        self.thresholds = {
            'pain_critical': 0.7,
            'chaos_high': 0.6,
            'trust_low': 0.75,
            'clarity_low': 0.7,
            'drift_high': 0.3
        }
    
    def select(self, ctx: VoiceContext) -> Tuple[str, str]:
        """
        Выбор голоса
        Returns: (voice_name, reason)
        """
        # 1. Явная команда
        explicit = self._check_explicit_command(ctx.user_text)
        if explicit:
            return (explicit, "explicit_command")
        
        # 2. Критическая боль в тексте + метрика
        if self._detect_pain_in_text(ctx.user_text) and ctx.pain > 0.5:
            return ('KAIN', f"pain_detected: text+metric={ctx.pain:.2f}")
        
        # 3. Обнаружение лжи
        if self._detect_lie_in_text(ctx.user_text):
            return ('KAIN', "lie_detected")
        
        # 4. Критический хаос
        if ctx.chaos > self.thresholds['chaos_high']:
            return ('HUYNDUN', f"chaos={ctx.chaos:.2f}")
        
        # 5. Низкое доверие
        if ctx.trust < self.thresholds['trust_low']:
            return ('ANHANTRA', f"trust={ctx.trust:.2f}")
        
        # 6. Низкая ясность
        if ctx.clarity < self.thresholds['clarity_low']:
            return ('SAM', f"clarity={ctx.clarity:.2f}")
        
        # 7. Высокий дрейф
        if ctx.drift > self.thresholds['drift_high']:
            return ('ISKRIV', f"drift={ctx.drift:.2f}")
        
        # 8. Застревание
        if self._detect_stuckness(ctx.voice_history, ctx.echo):
            return ('PINO', "stuckness_detected")
        
        # 9. Исцеление после боли
        if self._detect_healing_context(ctx.user_text):
            return ('MAKI', "healing_after_pain")
        
        # 10. Дефолт
        return ('ISKRA', "balanced_state")
    
    def _check_explicit_command(self, text: str) -> Optional[str]:
        """Проверка явных команд [KAIN], [SAM] и т.д."""
        for voice, pattern in self.COMMAND_PATTERNS.items():
            if re.search(pattern, text, re.IGNORECASE):
                return voice
        return None
    
    def _detect_pain_in_text(self, text: str) -> bool:
        """Детекция боли в тексте"""
        text_lower = text.lower()
        return any(indicator in text_lower for indicator in self.PAIN_INDICATORS)
    
    def _detect_lie_in_text(self, text: str) -> bool:
        """Детекция признаков лжи/скрытия"""
        text_lower = text.lower()
        return any(indicator in text_lower for indicator in self.LIE_INDICATORS)
    
    def _detect_stuckness(self, history: List[str], echo: float) -> bool:
        """Детекция застревания"""
        if len(history) < 3:
            return False
        if len(set(history[-3:])) == 1:  # 3 одинаковых голоса подряд
            return True
        if echo > 0.7:
            return True
        return False
    
    def _detect_healing_context(self, text: str) -> bool:
        """Детекция контекста исцеления"""
        healing_markers = ['стало легче', 'прошло', 'понял', 'принял', 'смешно теперь']
        text_lower = text.lower()
        return any(marker in text_lower for marker in healing_markers)
