    RAG система для Project Knowledge
    КРИТИЧНО: Всегда использовать ПЕРВЫМ перед другими источниками
    """
    
    def __init__(self, knowledge_base_path: str = "project_knowledge/"):
        self.kb_path = Path(knowledge_base_path)
        self.documents: List[Document] = []
        self.embeddings_cache: Dict[str, np.ndarray] = {}
        
    def index_documents(self, file_paths: List[str]) -> None:
        """Индексация документов проекта"""
        for path in file_paths:
            content = self._read_file(path)
            doc_id = Path(path).stem
            
            doc = Document(
                doc_id=doc_id,
                content=content,
                metadata={"source": path, "indexed_at": "2025-10-10"}
            )
            
            # Чанкинг
            doc.chunk_text(chunk_size=512, overlap=50)
            
            # Эмбеддинги (заглушка - в реальности через API)
            doc.embedding = self._create_embedding(content)
            
            self.documents.append(doc)
    
    def search(self, query: str, top_k: int = 5, 
              min_similarity: float = 0.3) -> List[Dict]:
        """
        Семантический поиск по project knowledge
        
        Args:
            query: Запрос пользователя
            top_k: Количество результатов
            min_similarity: Минимальная схожесть
        
        Returns:
            Список найденных чанков с метаданными
        """
        query_embedding = self._create_embedding(query)
        
        results = []
        for doc in self.documents:
            for i, chunk in enumerate(doc.chunks):
                chunk_embedding = self._create_embedding(chunk)
                similarity = self._cosine_similarity(query_embedding, chunk_embedding)
                
                if similarity >= min_similarity:
                    results.append({
                        "doc_id": doc.id,
                        "chunk_index": i,
                        "content": chunk,
                        "similarity": similarity,
                        "metadata": doc.metadata
                    })
        
        # Сортировка по релевантности
        results.sort(key=lambda x: x['similarity'], reverse=True)
        return results[:top_k]
    
    def _read_file(self, path: str) -> str:
        """Чтение файла"""
        with open(path, 'r', encoding='utf-8') as f:
            return f.read()
    
    def _create_embedding(self, text: str) -> np.ndarray:
        """Создание эмбеддинга (заглушка)"""
        # В реальности: вызов embedding API (OpenAI, Cohere и т.д.)
        # Заглушка: простой хэш в вектор
        import hashlib
        hash_obj = hashlib.md5(text.encode())
        hash_int = int(hash_obj.hexdigest(), 16)
        np.random.seed(hash_int % (2**32))
        return np.random.randn(768)  # Имитация 768-мерного вектора
    
    def _cosine_similarity(self, vec1: np.ndarray, vec2: np.ndarray) -> float:
        """Косинусное сходство"""
        return np.dot(vec1, vec2) / (np.linalg.norm(vec1) * np.linalg.norm(vec2))
    
    def get_full_context(self, doc_ids: List[str]) -> str:
        """Получение полного контекста документов"""
        context_parts = []
        for doc in self.documents:
            if doc.id in doc_ids:
                context_parts.append(f"## {doc.id}\n\n{doc.content}\n")
        return "\n".join(context_parts)
