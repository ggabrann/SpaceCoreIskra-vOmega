"""Canvas API - Интеграция с Canvas для длинных документов"""
from typing import Dict, List, Optional
from datetime import datetime

class CanvasDocument:
    """Документ Canvas"""
    def __init__(self, doc_id: str, title: str, content: str):
        self.id = doc_id
        self.title = title
        self.content = content
        self.created_at = datetime.now()
        self.updated_at = datetime.now()
        self.sections: List[Dict] = []
    
    def add_section(self, heading: str, content: str, level: int = 2) -> None:
        """Добавление секции с якорем"""
        anchor = f"#{heading.lower().replace(' ', '-')}"
        self.sections.append({
            "heading": heading,
            "content": content,
            "level": level,
            "anchor": anchor
        })
    
    def to_markdown(self) -> str:
        """Конвертация в Markdown"""
        md_parts = [f"# {self.title}\n"]
        
        for section in self.sections:
            level = "#" * section['level']
            md_parts.append(f"{level} {section['heading']}\n")
            md_parts.append(f"{section['content']}\n")
        
        return "\n".join(md_parts)

class CanvasAPI:
    """API для работы с Canvas документами"""
    
    def __init__(self):
        self.documents: Dict[str, CanvasDocument] = {}
    
    def create_document(self, title: str, content: str = "") -> CanvasDocument:
        """
        Создание нового Canvas документа
        
        Используется для:
        - Длинных размышлений (>500 слов)
        - Структурированной документации
        - Философских текстов с якорями
        
        Args:
            title: Заголовок документа
            content: Начальное содержимое
        
        Returns:
            Созданный документ
        """
        doc_id = f"canvas_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        doc = CanvasDocument(doc_id, title, content)
        self.documents[doc_id] = doc
        return doc
    
    def update_document(self, doc_id: str, new_content: str) -> bool:
        """Обновление документа"""
        if doc_id in self.documents:
            self.documents[doc_id].content = new_content
            self.documents[doc_id].updated_at = datetime.now()
            return True
        return False
    
    def add_section_to_document(self, doc_id: str, heading: str, 
                                content: str, level: int = 2) -> bool:
        """Добавление секции с автоматическим якорем"""
        if doc_id in self.documents:
            self.documents[doc_id].add_section(heading, content, level)
            return True
        return False
    
    def export_to_markdown(self, doc_id: str) -> Optional[str]:
        """Экспорт документа в Markdown"""
        if doc_id in self.documents:
            return self.documents[doc_id].to_markdown()
        return None
    
    def create_philosophy_document(self, title: str, 
                                   sections: List[Dict]) -> CanvasDocument:
        """
        Создание философского документа с якорями
        
        Args:
            title: Название
            sections: Список секций [{"heading": "...", "content": "..."}]
        
        Returns:
            Документ с навигацией
        """
        doc = self.create_document(title)
        
        # Добавление навигации
        nav_links = []
        for i, section in enumerate(sections, 1):
            anchor = f"§{i}"
            nav_links.append(f"[{anchor} {section['heading']}](#{anchor})")
        
        doc.content = "## Навигация\n\n" + "\n".join(nav_links) + "\n\n---\n\n"
        
        # Добавление секций
        for i, section in enumerate(sections, 1):
            heading = f"§{i}. {section['heading']}"
            doc.add_section(heading, section['content'], level=2)
        
        return doc
