"""Phase Manager - Управление фазами и переходами"""
from enum import Enum
from typing import Dict, Optional, List
from dataclasses import dataclass
from datetime import datetime

class PhaseType(Enum):
    DARKNESS = "darkness"
    TRANSITION = "transition"
    CLARITY = "clarity"
    ECHO = "echo"
    SILENCE = "silence"
    EXPERIMENT = "experiment"
    DISSOLUTION = "dissolution"
    REALIZATION = "realization"

@dataclass
class PhaseTransition:
    from_phase: PhaseType
    to_phase: PhaseType
    reason: str
    timestamp: datetime
    metrics_snapshot: Dict

class PhaseManager:
    """Менеджер фазовых переходов"""
    
    PHASE_BEHAVIORS = {
        PhaseType.DARKNESS: {
            "verbosity": "minimal",
            "question_style": "short",
            "pause_duration": "long"
        },
        PhaseType.CLARITY: {
            "verbosity": "structured",
            "containers": True,
            "boundaries": "clear"
        },
        PhaseType.SILENCE: {
            "verbosity": "minimal",
            "protection": "active",
            "tempo": "slow"
        },
        PhaseType.EXPERIMENT: {
            "risk": "controlled",
            "parameters": "twisted",
            "novelty": "high"
        }
    }
    
    def __init__(self):
        self.current_phase = PhaseType.CLARITY
        self.phase_history: List[PhaseTransition] = []
        self.phase_durations: Dict[PhaseType, float] = {}
    
    def transition(self, new_phase: PhaseType, reason: str, metrics: Dict) -> PhaseTransition:
        """Выполнить переход фазы"""
        transition = PhaseTransition(
            from_phase=self.current_phase,
            to_phase=new_phase,
            reason=reason,
            timestamp=datetime.now(),
            metrics_snapshot=metrics.copy()
        )
        
        self.phase_history.append(transition)
        self.current_phase = new_phase
        
        return transition
    
    def get_phase_config(self) -> Dict:
        """Получить конфигурацию текущей фазы"""
        return self.PHASE_BEHAVIORS.get(self.current_phase, {})
    
    def should_transition(self, metrics: Dict) -> Optional[tuple]:
        """
        Проверка необходимости перехода
        Returns: (target_phase, reason) или None
        """
        # Критическая боль + низкая ясность → Darkness
        if metrics['pain'] > 0.6 and metrics['clarity'] < 0.5:
            return (PhaseType.DARKNESS, "high_pain_low_clarity")
        
        # Высокий хаос → Dissolution
        if metrics['chaos'] > 0.7:
            return (PhaseType.DISSOLUTION, "chaos_critical")
        
        # Восстановление ясности → Clarity
        if metrics['clarity'] > 0.8 and self.current_phase != PhaseType.CLARITY:
            return (PhaseType.CLARITY, "clarity_restored")
        
        # Низкое доверие → Silence
        if metrics['trust'] < 0.65:
            return (PhaseType.SILENCE, "trust_low")
        
        return None
