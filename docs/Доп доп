            current = queue.pop(0)
            if current in visited:
                continue
            
            visited.add(current)
            community.append(current)
            
            if current in self.entities:
                for neighbor in self.entities[current].connections:
                    if neighbor not in visited:
                        queue.append(neighbor)
        
        return community
    
    def create_community_summary(self, community_id: str) -> str:
        """Создание сводки сообщества"""
        if community_id not in self.communities:
            return ""
        
        entity_ids = self.communities[community_id]
        entities = [self.entities[eid] for eid in entity_ids if eid in self.entities]
        
        summary_parts = [f"Сообщество '{community_id}' содержит {len(entities)} сущностей:"]
        
        # Группировка по типам
        by_type = defaultdict(list)
        for entity in entities:
            by_type[entity.type].append(entity.name)
        
        for etype, names in by_type.items():
            summary_parts.append(f"- {etype}: {', '.join(names[:5])}")
        
        # Связи внутри сообщества
        internal_rels = [
            r for r in self.relationships
            if r.source in entity_ids and r.target in entity_ids
        ]
        summary_parts.append(f"Связей: {len(internal_rels)}")
        
        return "\n".join(summary_parts)
    
    def query_graph(self, query: str, max_hops: int = 2) -> List[Dict]:
        """
        Запрос к графу с обходом связей
        
        Args:
            query: Поисковый запрос
            max_hops: Максимальное количество переходов по связям
        
        Returns:
            Список релевантных сущностей и их связей
        """
        # Поиск начальных сущностей
        query_lower = query.lower()
        start_entities = [
            e for e in self.entities.values()
            if query_lower in e.name.lower() or 
               any(query_lower in str(v).lower() for v in e.attributes.values())
        ]
        
        if not start_entities:
            return []
        
        # Обход графа с ограничением глубины
        results = []
        for entity in start_entities:
            subgraph = self._explore_subgraph(entity.id, max_hops)
            results.append({
                "root_entity": entity.to_dict(),
                "subgraph": subgraph,
                "relevance": self._calculate_relevance(entity, query)
            })
        
        results.sort(key=lambda x: x['relevance'], reverse=True)
        return results
    
    def _explore_subgraph(self, start_id: str, max_hops: int) -> Dict:
        """Исследование подграфа от стартовой сущности"""
        visited = set()
        queue = [(start_id, 0)]  # (entity_id, hop_count)
        
        subgraph_entities = []
        subgraph_rels = []
        
        while queue:
            current_id, hops = queue.pop(0)
            
            if current_id in visited or hops > max_hops:
                continue
            
            visited.add(current_id)
            
            if current_id in self.entities:
                entity = self.entities[current_id]
                subgraph_entities.append(entity.to_dict())
                
                # Добавляем соседей
                for neighbor_id in entity.connections:
                    queue.append((neighbor_id, hops + 1))
                
                # Добавляем связи
                for rel in self.relationships:
                    if rel.source == current_id or rel.target == current_id:
                        subgraph_rels.append(rel.to_dict())
        
        return {
            "entities": subgraph_entities,
            "relationships": subgraph_rels
        }
    
    def _calculate_relevance(self, entity: Entity, query: str) -> float:
        """Расчёт релевантности сущности запросу"""
        query_lower = query.lower()
        score = 0.0
        
        # Прямое вхождение в имя
        if query_lower in entity.name.lower():
            score += 1.0
        
        # Вхождение в атрибуты
        for value in entity.attributes.values():
            if query_lower in str(value).lower():
                score += 0.5
        
        # Бонус за количество связей (авторитетность)
        score += len(entity.connections) * 0.1
        
        return score
    
    def export_graph(self, output_path: str) -> None:
        """Экспорт графа в JSON"""
        graph_data = {
            "entities": [e.to_dict() for e in self.entities.values()],
            "relationships": [r.to_dict() for r in self.relationships],
            "communities": self.communities
        }
        
        with open(output_path, 'w', encoding='utf-8') as f:
            json.dump(graph_data, f, ensure_ascii=False, indent=2)
